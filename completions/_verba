#compdef verba
# zsh completion for verba.
#
# Completes verba's own options; the first non-option word is the traced
# <command>, after which completion hands off to the normal command/argument
# completers (so `verba [opts] mycmd <TAB>` completes mycmd's own arguments).

_verba()
{
	local curcontext="$curcontext" state line
	typeset -A opt_args

	_arguments -s -S \
		'(-h --help)'{-h,--help}'[show help and exit]' \
		'(-V --version)'{-V,--version}'[show version and exit]' \
		'--json[write the JSON report to stdout]' \
		'(-o --output)'{-o,--output}'[write the JSON report to FILE]:file:_files' \
		'*--allow[treat writes under PREFIX as declared]:prefix:_files -/' \
		'--tty[run the command on a pty (one combined stream)]' \
		'--follow[attach to an already running process]:pid:_pids' \
		'--heuristic[also run mistranslation checks (separate block)]' \
		'--strict[run heuristics and count them toward the exit code]' \
		'*--patterns[load extra errno<->phrase patterns from FILE]:file:_files' \
		'(-)1:command:_command_names -e' \
		'*::arguments:->args'

	if [[ $state == args ]]; then
		# Hand off to the completion of the traced command itself.
		words=("${line[@]}")
		(( CURRENT -= 1 ))
		_normal
	fi
}

_verba "$@"
